# ==============================
# HTX Bình Mỹ - Environment Config
# ==============================
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env lên Git.

NODE_ENV=development
PORT=3000

# JWT — sinh bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=thay-the-bang-chuoi-bi-mat-dai-64-ky-tu-tro-len
JWT_EXPIRES_IN=7d

# Admin mặc định (sẽ tự hash khi khởi động lần đầu)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Logging
LOG_LEVEL=info
